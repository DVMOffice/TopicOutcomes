rules_version = '2';

// ---------------------------------------------------------------
// Access model:
//
// - Anyone signed in (instructor email OR anonymous guest) can READ
//   instructors / topics / accessCodes.
// - Only the specific admin emails listed in isAdminEmail() can
//   WRITE to instructors (create/edit the roster) or CREATE/DELETE
//   topics — this is what protects the data import in admin.html.
// - Any signed-in user (including guests) can UPDATE a topic —
//   that's how instructors add/edit/delete learning outcomes.
// - accessCodes is only ever written manually from the Firebase
//   console (Firestore Database > + Start collection), never from
//   the app.
//
// To add or remove an administrator, just edit the email list below
// and republish these rules — no backend, no extra keys needed.
// ---------------------------------------------------------------
function isSignedIn() {
  return request.auth != null;
}

function isAdminEmail() {
  return isSignedIn() && request.auth.token.email in [
    "elsa.sanchez@ucalgary.ca",
    "karen.schale@ucalgary.ca"
  ];
}

match /databases/{database}/documents {

  match /instructors/{instructorId} {
    allow read: if isSignedIn();
    allow write: if isAdminEmail();
  }

  match /accessCodes/{year} {
    allow read: if isSignedIn();
    allow write: if false; // edited only from the Firebase console
  }

  match /guestSessions/{uid} {
    allow read, write: if isSignedIn() && request.auth.uid == uid;
  }

  match /topics/{topicId} {
    allow read: if isSignedIn();
    allow create, delete: if isAdminEmail(); // bulk import / admin only
    allow update: if isSignedIn(); // add/edit/delete outcomes (includes guests)
  }
}
