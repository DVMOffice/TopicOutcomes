rules_version = '2';

// ---------------------------------------------------------------
// Access model (no email, no passwords, no PINs):
//
// - Everyone signs in anonymously (instructors AND admins) after
//   typing a code: instructors use their academic-year code,
//   admins use a separate admin code. Neither code is ever
//   readable by the client directly — Firestore rules compare the
//   code the client submits against the real one internally.
//
// - Anyone signed in can READ instructors / topics / accessCodes.
// - Anyone signed in can UPDATE a topic (add/edit/delete outcomes) —
//   that's normal instructor collaboration.
// - Only someone who successfully validated the admin code (which
//   creates an adminSessions/{uid} document) can WRITE to
//   instructors, or CREATE/DELETE topics — this protects bulk
//   import/management in admin.html.
//
// To change the admin code or the per-year codes, edit them
// directly in Firestore Database > Data (adminAccess/main and
// accessCodes/{year}) — no redeploy needed.
// ---------------------------------------------------------------
function isSignedIn() {
  return request.auth != null;
}

function isAdmin() {
  return isSignedIn() &&
    exists(/databases/$(database)/documents/adminSessions/$(request.auth.uid));
}

match /databases/{database}/documents {

  match /instructors/{instructorId} {
    allow read: if isSignedIn();
    allow write: if isAdmin();
  }

  match /accessCodes/{year} {
    allow read: if isSignedIn();
    allow write: if false; // edited only from the Firebase console
  }

  match /adminAccess/{docId} {
    allow read: if false;  // never readable by clients directly
    allow write: if false; // edited only from the Firebase console
  }

  match /adminSessions/{uid} {
    allow read: if isSignedIn() && request.auth.uid == uid;
    // Self-registers as admin ONLY if the code submitted matches the
    // real one stored in adminAccess/main. The client never gets to
    // read that real value — this comparison happens server-side.
    allow create: if isSignedIn() && request.auth.uid == uid
      && request.resource.data.codeProvided ==
         get(/databases/$(database)/documents/adminAccess/main).data.code;
    allow update: if false;
    allow delete: if isSignedIn() && request.auth.uid == uid; // allows "log out of admin"
  }

  match /guestSessions/{uid} {
    allow read, write: if isSignedIn() && request.auth.uid == uid;
  }

  match /topics/{topicId} {
    allow read: if isSignedIn();
    allow create, delete: if isAdmin(); // bulk import / admin only
    allow update: if isSignedIn();      // add/edit/delete outcomes
  }
}
