rules_version = '2';

// ---------------------------------------------------------------
// Simplified model (no backend, no admin service account keys):
//
// - Anyone signed in (instructor email OR anonymous guest) can READ
//   instructors / topics / accessCodes.
// - Only instructors with a real email (not anonymous/guests) can
//   WRITE: adding outcomes to a topic, or doing the initial data
//   import from admin.html.
// - accessCodes is only ever written manually from the Firebase
//   console (Firestore Database > + Start collection), never from
//   the app.
//
// Security note: this trusts that only you know the URL of
// admin.html. If later you want to restrict importing to a single
// person, uncomment isAdminEmail() below and use it instead of
// isRealInstructor() for instructors/topics create — no backend or
// extra keys required.
// ---------------------------------------------------------------
function isSignedIn() {
  return request.auth != null;
}

function isRealInstructor() {
  // true for email login; false for guest (anonymous) login
  return isSignedIn() && request.auth.token.firebase.sign_in_provider != "anonymous";
}

// function isAdminEmail() {
//   return isSignedIn() && request.auth.token.email in [
//     "your-email@example.com"
//   ];
// }

match /databases/{database}/documents {

  match /instructors/{instructorId} {
    allow read: if isSignedIn();
    allow write: if isRealInstructor();
  }

  match /accessCodes/{year} {
    allow read: if isSignedIn();
    allow write: if false; // edited only from the Firebase console
  }

  match /guestSessions/{uid} {
    allow read, write: if isSignedIn() && request.auth.uid == uid;
  }

  match /topics/{topicId} {
    allow read: if isSignedIn();
    allow create, delete: if isRealInstructor(); // initial import
    allow update: if isSignedIn(); // add/edit/delete outcomes (includes guests)
  }
}
